# === AGA Bait Registry — แม่แบบ environment ===
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (ห้าม commit .env.local — อยู่ใน .gitignore)
# Production: ใส่ค่าใน Environment Variable ของ Vercel เท่านั้น (CLAUDE.md ข้อ 8)

# --- Supabase (จาก Project Settings > API) ---
# ค่า 2 ตัวนี้เปิดเผยฝั่ง browser ได้ (ขึ้นต้น NEXT_PUBLIC_) — ความปลอดภัยบังคับที่ RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service role key — ข้ามสิทธิ์ RLS ทั้งหมด ใช้ฝั่ง server เท่านั้น ห้ามหลุดฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Dashboard Sync (SPEC §9) ---
# GitHub token สำหรับ commit dashboard_data.json ไป repo 13azukaoab/AGA-Bait-Dashboard
GITHUB_TOKEN=your-github-token

# --- Vercel Cron (SPEC §9.2) ---
# ความลับกันคนนอกยิง endpoint /api/cron/sync (Vercel ส่ง header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-cron-secret

# --- Sentry เก็บ error (M32 · docs/คู่มือ Sentry.md) ---
# ไม่ใส่ DSN = Sentry ปิดตัวเองเงียบๆ · ส่งเฉพาะ Production · ตั้งใน Vercel (เฉพาะ Production) เท่านั้น
# DSN เปิดเผยฝั่ง browser ได้ (ขึ้นต้น NEXT_PUBLIC_) — ใช้ส่ง error เข้า Sentry เท่านั้น อ่านข้อมูลไม่ได้
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Organization Auth Token (สิทธิ์น้อยสุด) — ใช้ตอน build อัปโหลด source map เท่านั้น ห้ามขึ้นต้น NEXT_PUBLIC_ / ห้ามหลุดฝั่ง client
# ไม่ใส่ = build ผ่านปกติ แค่ไม่อัปโหลด source map
SENTRY_AUTH_TOKEN=

# Microsoft Clarity Project ID (ช่วง UAT · M36) — โหลดเฉพาะ production เมื่อมีค่า (ตัวพิมพ์เล็ก/ตัวเลข 8-12 ตัว) · ว่าง = ไม่โหลด
NEXT_PUBLIC_CLARITY_ID=
