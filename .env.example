# === AGA Bait Registry — แม่แบบ environment ===
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (ห้าม commit .env.local — อยู่ใน .gitignore)
# Production: ใส่ค่าใน Environment Variable ของ Vercel เท่านั้น (CLAUDE.md ข้อ 8)

# --- Supabase (จาก Project Settings > API) ---
# ค่า 2 ตัวนี้เปิดเผยฝั่ง browser ได้ (ขึ้นต้น NEXT_PUBLIC_) — ความปลอดภัยบังคับที่ RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service role key — ข้ามสิทธิ์ RLS ทั้งหมด ใช้ฝั่ง server เท่านั้น ห้ามหลุดฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Dashboard Sync (SPEC §9) ---
# GitHub token สำหรับ commit dashboard_data.json ไป repo 13azukaoab/AGA-Bait-Dashboard
GITHUB_TOKEN=your-github-token

# --- Vercel Cron (SPEC §9.2) ---
# ความลับกันคนนอกยิง endpoint /api/cron/sync (Vercel ส่ง header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-cron-secret
