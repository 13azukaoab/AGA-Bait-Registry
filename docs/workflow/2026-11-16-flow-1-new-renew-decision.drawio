<mxfile host="app.diagrams.net"><diagram name="2026-11-16-flow-1-new-renew-decision" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Flow 1 · เปิดงาน: ตัดสินใจ New หรือ Renew" style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=20;fontColor=#1E293B;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1380" height="34" as="geometry"/></mxCell><mxCell id="c3" value='ผู้ใช้: แอดมิน (admin) · หน้า "เปิดงาน" · เพิ่มทีละแถวต่อ 1 สัญญา · อ้างอิง DECISIONS 2.50 / 2.51 / M28 / M28b' style="text;html=1;whiteSpace=wrap;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=middle;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1380" height="24" as="geometry"/></mxCell><mxCell id="c4" value="แอดมินเพิ่มแถวสัญญาในหน้าเปิดงาน" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#1F5FA8;fillColor=#E6F0FB;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5" value="ลูกค้ารายนี้มี&lt;br&gt;สัญญาเก่าในระบบหรือไม่?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#A86C07;fillColor=#FBF0DB;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="170" width="340" height="110" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="New (ลูกค้าใหม่)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#0F766E;fillColor=#E3F4F1;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="250" height="60" as="geometry"/></mxCell><mxCell id="c8" value="ไม่มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="เจอ: เทียบเดือนเริ่มสัญญาใหม่&lt;br&gt;กับเดือนบริการสุดท้ายของสัญญาเก่า" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#475569;fillColor=#EEF2F7;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="เจอสัญญาเก่า" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="ห่างกัน ≤ 2 เดือน&lt;br&gt;หรือไม่?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#A86C07;fillColor=#FBF0DB;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="440" width="340" height="110" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Renew ได้&lt;br&gt;ผูกกับสัญญาเก่า (renewed_from)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#0F766E;fillColor=#E3F4F1;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="300" height="80" as="geometry"/></mxCell><mxCell id="c14" value="ใช่ (เริ่มเดือนที่ 1-2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value='สถานี IG เดิมของสัญญาเก่า (2.50)&lt;br&gt;- เก็บแล้ว: ไม่ย้าย อยู่กับสัญญาเก่า&lt;br&gt;- ไม่เก็บ (ทิ้งไว้): ย้ายไปสัญญาใหม่ได้&lt;br&gt;  (สัญญาเก่าแสดง "ย้ายไปสัญญาใหม่")&lt;br&gt;- ยังไม่ได้บันทึก: ย้ายตามเดิม' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;strokeColor=#475569;fillColor=#EEF2F7;strokeWidth=1.5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="300" height="150" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="ระบบบังคับเป็น New&lt;br&gt;(เลือก Renew ไม่ได้)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#B4361F;fillColor=#FCE6DA;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="300" height="80" as="geometry"/></mxCell><mxCell id="c18" value="ไม่ใช่ (เริ่มเดือนที่ 3 ขึ้นไป)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="New = นับหนึ่งใหม่&lt;br&gt;- ไม่ผูกสัญญาเก่า / ไม่ย้ายสถานีเดิม&lt;br&gt;- ตกบริการค้างของสัญญาเก่า&lt;br&gt;  เป็นโมฆะอัตโนมัติ (2.51)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;strokeColor=#475569;fillColor=#EEF2F7;strokeWidth=1.5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="300" height="120" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value='ลูกค้าบอกว่าเป็น Renew แต่หาสัญญาเก่าไม่เจอ&lt;br&gt;บันทึกเป็น "Renew ไม่ผูก" + ใส่เหตุผล&lt;br&gt;(ทำได้เฉพาะช่วงแรก: ถึง allow_unlinked_renew_until&lt;br&gt;ค่าเริ่มต้น 2027-04-01)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;strokeColor=#A86C07;fillColor=#FBF0DB;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="175" width="500" height="100" as="geometry"/></mxCell><mxCell id="c22" value="หาไม่เจอ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value='ขึ้นในรายการ "Renew ที่ยังไม่ผูก"' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=13;fontColor=#1E293B;strokeColor=#A86C07;fillColor=#FBF0DB;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="320" width="500" height="60" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="host หรือ admin (ในขอบเขตสาขา)&lt;br&gt;เชื่อมสัญญาเก่าภายหลัง&lt;br&gt;(ตรวจกฎ 2 เดือนอีกครั้ง)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;strokeColor=#0F766E;fillColor=#E3F4F1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="240" height="120" as="geometry"/></mxCell><mxCell id="c26" value='หรือปิดเป็น&lt;br&gt;"ไม่มีสัญญาเก่าในระบบ"&lt;br&gt;(บันทึกประวัติ · เชื่อมทีหลังได้&lt;br&gt;และล้างสถานะปิด)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;strokeColor=#475569;fillColor=#EEF2F7;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="420" width="240" height="120" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=11;fontColor=#1E293B;strokeColor=#475569;strokeWidth=1.8;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value='ระบบคำนวณให้อัตโนมัติทุกแถวสัญญา (ไม่ต้องกรอก)&lt;br&gt;- Tier จากมูลค่าต่อปี (อ่านเกณฑ์จากตาราง tier_rules)&lt;br&gt;- ระยะสัญญา: 1 ปี (12) / 3 ปี (36) / Custom 1-35 เดือน&lt;br&gt;- มูลค่า: ระยะ ≥ 12 เดือน = มูลค่า ÷ (เดือน/12)&lt;br&gt;  ระยะ &lt; 12 เดือน = มูลค่าจริง&lt;br&gt;- Custom นับในกลุ่ม "1 ปี" บน Dashboard&lt;br&gt;- วันสิ้นสุดสัญญา และเดือนบริการ' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Noto Sans Thai,Leelawadee UI,Tahoma;fontSize=12;fontColor=#1E293B;strokeColor=#1F5FA8;fillColor=#E6F0FB;strokeWidth=1.5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="640" width="520" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>